# View: money flow only. Hide the whole model, then re-reveal
# just the edges that charge or persist money (and their endpoints).
...@model

**: suspend
(** -> **)[*]: suspend

(** -> **)[*]: unsuspend {
  &label: charge
}
(** -> **)[*]: unsuspend {
  &label: INSERT
}

# View-level layout override: the surviving chain renders as a wide banner
# (a=4.5 left-to-right) otherwise; down stacks it inside the 0.4..2.5 band.
direction: down
