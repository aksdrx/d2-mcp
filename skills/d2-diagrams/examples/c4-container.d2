# C4-style container diagram: people, system boundary, containers with
# technology + responsibility descriptions.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 105
    pad: 40
  }
}

# Bake-off (d2 v0.9.0): dagre/down 1088x1055 (a=1.03, 0 crossings,
# 0 slices) wins; elk/down is 0.41 tall, dagre/right 2.66 with an edge slicing
# the mainframe. Direction down + dagre pinned below.
direction: down

title: Internet Banking — Container Diagram (C4 level 2) {
  near: top-center
  shape: text
  style.font-size: 26
}

customer: Personal Banking Customer {
  shape: c4-person
  tooltip: Wants to check balances and make payments
}

bank: Internet Banking System {
  style: {
    stroke: "#1565C0"
    stroke-width: 3
    border-radius: 12
  }

  spa: Single-Page Application {
    shape: rectangle
    tooltip: |md
      **Tech:** React
      Delivers the banking UI in the browser.
    |
  }

  mobile: Mobile App {
    tooltip: "**Tech:** Xamarin — iOS/Android client"
  }

  api: API Application {
    shape: hexagon
    tooltip: "**Tech:** Java/Spring — business logic, authN/authZ"
  }

  db: Database {
    shape: cylinder
    tooltip: "**Tech:** Oracle — accounts, transactions"
  }

  spa -> api: JSON/HTTPS
  mobile -> api: JSON/HTTPS
  api -> db: JDBC
}

mainframe: Mainframe Banking System {
  style.stroke-dash: 4
  tooltip: Core banking ledger (existing)
}

email: E-mail System {
  shape: cloud
  style.stroke-dash: 4
}

customer -> bank.spa: uses
customer -> bank.mobile: uses
bank.api -> mainframe: payments & balances
bank.api -> email: sends statements
