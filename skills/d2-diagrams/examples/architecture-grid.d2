# Layered architecture, tiers stacked with a root-level grid.
# Bake-off (this file, d2 v0.9.0): dagre 1377x1306 (a=1.05), elk 1337x1310
# (a=1.02), tala 1039x1502 (a=0.69); 0 crossings, 0 edge-over-shape on all —
# dagre pinned below. Aspect inside the 3:2-16:9 band.

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 105
    pad: 40
  }
}

title: E-Commerce Platform — Layered Architecture {
  near: top-center
  shape: text
  style.font-size: 28
}

classes: {
  layer: {
    style: {
      border-radius: 12
      stroke-width: 2
    }
  }
  stateless: {style.fill: "#E3F2FD"}
  stateful: {shape: cylinder; style.fill: "#FFF3E0"}
  external: {style.stroke-dash: 4}
}

# Root-level grid: one row per tier, stacked top to bottom.
# (grid-* on a container alone makes siblings arrange left-to-right on
# dagre/elk regardless of direction — the root grid is what stacks them.)
grid-rows: 4
direction: down

client: Client Tier {
  class: layer
  grid-columns: 3

  web: Web App (React) {class: stateless}
  mobile: Mobile App {class: stateless}
  partner: Partner Portal {class: [stateless; external]}
}

edge: Edge Tier {
  class: layer
  grid-columns: 2

  cdn: CDN {shape: cloud}
  waf: WAF + API Gateway {class: stateless}
}

services: Service Tier {
  class: layer
  grid-columns: 3

  orders: Orders {class: stateless}
  payments: Payments {class: stateless}
  search: Search {class: stateless}
}

data: Data Tier {
  class: layer
  grid-columns: 3

  orders_db: Orders DB {class: stateful}
  ledger: Ledger DB {class: stateful}
  index: Search Index {class: stateful}
}

client.web -> edge.cdn: HTTPS
client.mobile -> edge.waf: HTTPS
edge.waf -> services.orders: REST
edge.waf -> services.payments: REST
edge.waf -> services.search: gRPC
services.orders -> data.orders_db: SQL
services.payments -> data.ledger: strong consistency
services.search -> data.index: writes

legend: {
  near: bottom-right
  s: Stateless service {style.fill: "#E3F2FD"}
  d: Datastore {shape: cylinder; style.fill: "#FFF3E0"}
  e: External / untrusted {style.stroke-dash: 4}
}
